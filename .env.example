# Copy this file to .env.local and fill in the four values from your Supabase
# project. Never commit .env.local.

# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret: full access to the project. Server only.
SUPABASE_SECRET_KEY=

# Connect > Transaction pooler (contains the database password)
DATABASE_URL=
